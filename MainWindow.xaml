<Window x:Class="PsWinSnip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PsWinSnip"
        mc:Ignorable="d"
        Title="PsWinSnip Settings" Height="400" Width="450"
        Background="#1E1E1E" Foreground="White"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="LightGray"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3F3F3F"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#3F3F3F"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="PsWinSnip Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Aspect Ratio -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <Label Content="Default Aspect Ratio:" Width="150"/>
            <ComboBox x:Name="ComboRatio" Width="150" SelectionChanged="OnComboRatioChanged">
                <ComboBoxItem Content="Free" Tag=""/>
                <ComboBoxItem Content="1:1" Tag="1.0"/>
                <ComboBoxItem Content="4:5" Tag="0.8"/>
                <ComboBoxItem Content="3:4" Tag="0.75"/>
            </ComboBox>
        </StackPanel>

        <!-- Dimensions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15" VerticalAlignment="Center">
            <Label Content="Width (px):" Width="100"/>
            <TextBox x:Name="TxtWidth" Width="60" PreviewTextInput="OnNumericTextInput" TextChanged="OnDimensionTextChanged"/>
            
            <Button x:Name="BtnToggleDriver" Content="&gt;" Width="30" Height="26" Margin="15,0,5,0" 
                    Background="#3F3F3F" Foreground="White" BorderThickness="0"
                    Click="OnToggleDriverClick" ToolTip="Toggle dimension driver"/>
            
            <Label Content="Height (px):" Margin="5,0,5,0"/>
            <TextBox x:Name="TxtHeight" Width="60" PreviewTextInput="OnNumericTextInput" TextChanged="OnDimensionTextChanged"/>
        </StackPanel>

        <!-- Behavior -->
        <StackPanel Grid.Row="3" Margin="0,0,0,15">
            <CheckBox x:Name="ChkRememberPosition" Content="Remember Last Position"/>
            <CheckBox x:Name="ChkShowGrid" Content="Show Alignment Grid by Default"/>
        </StackPanel>

        <!-- Hotkey Info -->
        <Border Grid.Row="4" Background="#2D2D2D" CornerRadius="5" Padding="10" Margin="0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Global Capture Shortcut: " Foreground="LightGray"/>
                <TextBlock Text="Ctrl + Shift + S" FontWeight="Bold" Foreground="#007ACC"/>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Width="80" Height="30" Margin="0,0,10,0" Click="OnSaveClick" 
                    Background="#007ACC" Foreground="White" BorderThickness="0"/>
            <Button Content="Cancel" Width="80" Height="30" Click="OnCancelClick"
                    Background="#3E3E42" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
