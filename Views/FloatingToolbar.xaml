<UserControl x:Class="PsWinSnip.Views.FloatingToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="40">
    <UserControl.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#66FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="3" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0088EE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Separator" TargetType="Rectangle">
            <Setter Property="Fill" Value="#44FFFFFF"/>
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="5,8"/>
        </Style>
    </UserControl.Resources>

    <Border Background="#EE1E1E1E" CornerRadius="5" Padding="5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <!-- Ratios -->
            <Button x:Name="Btn1_1" Content="1:1" Style="{StaticResource ToolbarButton}" Click="OnRatioClick" Tag="1.0"/>
            <Button x:Name="Btn4_5" Content="4:5" Style="{StaticResource ToolbarButton}" Click="OnRatioClick" Tag="0.8"/>
            <Button x:Name="Btn3_4" Content="3:4" Style="{StaticResource ToolbarButton}" Click="OnRatioClick" Tag="0.75"/>
            <Button x:Name="BtnFree" Content="Free" Style="{StaticResource ToolbarButton}" Click="OnRatioClick" Tag=""/>
            
            <Rectangle Style="{StaticResource Separator}"/>

            <!-- Actions -->
            <Button x:Name="BtnCopy" Content="Copy" Style="{StaticResource ToolbarButton}" Click="OnCopyClick"/>
            <Button x:Name="BtnSave" Content="Save" Style="{StaticResource PrimaryButton}" Click="OnSaveClick" Margin="5,0,0,0"/>
            
            <Rectangle Style="{StaticResource Separator}"/>
            
            <Button x:Name="BtnCancel" Content="✕" Style="{StaticResource ToolbarButton}" Click="OnCancelClick" Foreground="#FF5555"/>
        </StackPanel>
    </Border>
</UserControl>
